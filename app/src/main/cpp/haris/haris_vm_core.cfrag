    if(fn->loop_limit_is_local){int lidx=base+1+fn->loop_limit_local;Value limv=(lidx>=base+1&&lidx<sp)?st[lidx]:vn();if(limv.t!=VINT)limit_ok=0;else local_limit=limv.u.i;}
