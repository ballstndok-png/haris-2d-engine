    else{if(!isnum(a)||!isnum(b))die("comparison needs numbers");double x=dn(a),y=dn(b);r=op==I_EQ?x==y:op==I_NEQ?x!=y:op==I_LT?x<y:op==I_LTE?x<=y:op==I_GT?x>y:x>=y;}
