L_LOCAL_CONST_DIV: LOCAL_CONST_BIN(I_LOCAL_CONST_DIV,I_DIV);
L_LOCAL_CONST_MOD: LOCAL_CONST_BIN(I_LOCAL_CONST_MOD,I_MOD);
