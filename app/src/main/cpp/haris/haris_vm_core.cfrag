        &&L_JMP,&&L_JMPF,&&L_CALL,&&L_RET,&&L_ARRAY,&&L_INDEX,&&L_SETINDEX,&&L_FIELD,&&L_SETFIELD,&&L_STRUCT,&&L_TYPECHECK,&&L_TRY,&&L_ENDTRY,&&L_JMPNULL,&&L_HALT,
